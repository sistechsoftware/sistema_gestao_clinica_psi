# =============================================================================
# Exemplo de variáveis de ambiente — copie para .env (NUNCA commite o .env)
# Ambientes: local | development | staging | production (separe por ambiente)
# =============================================================================

# --- Banco de dados (PostgreSQL gerenciado) ---
# Runtime: connection pooler (PgBouncer/Neon pooler)
DATABASE_URL="postgresql://user:password@host-pooler:5432/dbname?schema=public"
# Migrations / introspecção: conexão direta
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Aplicação ---
NODE_ENV="development"
APP_ENV="local"
API_PORT="3000"
WEB_URL="http://localhost:5173"
API_URL="http://localhost:3000"

# --- Segurança ---
JWT_SECRET="troque-por-um-segredo-forte-minimo-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"
BCRYPT_ROUNDS="12"
# Chave mestra para cifragem de campo (AES-256-GCM) dos dados clínicos
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AES_MASTER_KEY="base64-de-32-bytes-aleatorios"

# --- Rate limiting ---
RATE_LIMIT_MAX="300"
RATE_LIMIT_TIME_WINDOW="1 minute"
RATE_LIMIT_AUTH_MAX="5"

# --- Testes de integração (opcional — sem isso, suites de integração pulam) ---
TEST_DATABASE_URL="postgresql://psa:psa@localhost:5432/psa_test?schema=public"

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_DOCUMENTS=""
R2_PUBLIC_BASE_URL=""

# --- Push (Web Push VAPID) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@seudominio.com.br"

# --- Provedores de comunicação (Fase 7) ---
# E-mail
EMAIL_PROVIDER="console" # console | resend | ses
RESEND_API_KEY=""
EMAIL_FROM="Sistema <no-reply@seudominio.com.br>"
# WhatsApp Business Platform (Meta Cloud API) — apenas API oficial
WHATSAPP_PROVIDER="none" # none | meta_cloud_api
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# SMS
SMS_PROVIDER="none" # none | twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# --- Worker de fila de notificações (Vercel Cron) ---
QUEUE_WORKER_TOKEN=""
